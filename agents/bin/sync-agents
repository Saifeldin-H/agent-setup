#!/usr/bin/env python3
"""Generate per-tool agent adapters and install skills from ~/.agents.

Sources : ~/.agents/roster.json, ~/.agents/roles/<role>.md, ~/.agents/common.md
Targets : ~/.claude/agents/<role>.md        (Claude Code subagents)
          ~/.codex/AGENTS.md -> ~/.claude/CLAUDE.md   (symlink; one shared global instruction file)
          ~/.claude/skills and ~/.agents/skills        (links from stack/stack.json)

Usage   : sync-agents          write adapters and update skill links
          sync-agents --check  report drift and refusals without writing
"""
from __future__ import annotations

import fcntl
import json
import os
import re
import stat
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
ROOT = HOME / ".agents"
STACK = ROOT / "stack"
LEDGER = STACK / ".installed.json"
DIGESTS = ROOT / ".orca-skill-digests"
SKILL_DIRS = {"claude": HOME / ".claude" / "skills", "codex": ROOT / "skills"}
SKILL_NAME = re.compile(r"[a-z0-9][a-z0-9-]*")
CLAUDE_DIR = HOME / ".claude" / "agents"
CODEX_AGENTS_MD = HOME / ".codex" / "AGENTS.md"
SHARED_INSTRUCTIONS = HOME / ".claude" / "CLAUDE.md"
READ_ONLY_DENY = ["Edit", "Write", "NotebookEdit"]
MARKER = "<!-- GENERATED by ~/.agents/bin/sync-agents — edit ~/.agents/roles/{role}.md or roster.json instead -->"


def yaml_str(s: str) -> str:
    return json.dumps(s, ensure_ascii=False)  # JSON string is valid YAML scalar


def build_claude(role: str, spec: dict, body: str, common: str) -> str:
    c = spec["claude"]
    fm = [
        "---",
        f"name: {role}",
        f"description: {yaml_str(spec['description'])}",
        f"model: {c['model']}",
    ]
    if c.get("effort"):
        fm.append(f"effort: {c['effort']}")
    if c.get("readOnly"):
        fm.append(f"disallowedTools: {', '.join(READ_ONLY_DENY)}")
    fm.append("---")
    return "\n".join(fm) + "\n" + MARKER.format(role=role) + "\n\n" + body.strip() + "\n\n" + common.strip() + "\n"


def sync_roles(check: bool) -> int:
    roster = json.loads((ROOT / "roster.json").read_text())
    common = (ROOT / "common.md").read_text() + "\n" + (ROOT / "result-schema.md").read_text().replace("# Result schema", "## Result schema", 1)
    if not check:
        CLAUDE_DIR.mkdir(parents=True, exist_ok=True)
    stale = []
    for role, spec in roster["roles"].items():
        body_path = ROOT / "roles" / f"{role}.md"
        if not body_path.exists():
            print(f"MISSING canonical role: {body_path}")
            stale.append(role)
            continue
        out = build_claude(role, spec, body_path.read_text(), common)
        target = CLAUDE_DIR / f"{role}.md"
        current = target.read_text() if target.exists() else None
        if current == out:
            print(f"ok      {target}")
            continue
        if check:
            print(f"STALE   {target}")
            stale.append(role)
        else:
            target.write_text(out)
            print(f"wrote   {target}")
    link_ok = CODEX_AGENTS_MD.is_symlink() and CODEX_AGENTS_MD.resolve() == SHARED_INSTRUCTIONS.resolve()
    if link_ok:
        print(f"ok      {CODEX_AGENTS_MD} -> {SHARED_INSTRUCTIONS}")
    elif check:
        print(f"STALE   {CODEX_AGENTS_MD} is not a symlink to {SHARED_INSTRUCTIONS}")
        stale.append("codex")
    elif CODEX_AGENTS_MD.exists() and not CODEX_AGENTS_MD.is_symlink() and "GENERATED by ~/.agents/bin/sync-agents" not in CODEX_AGENTS_MD.read_text():
        print(f"SKIP    {CODEX_AGENTS_MD} is a hand-written file; move it aside, then re-run")
        stale.append("codex")
    else:
        if CODEX_AGENTS_MD.exists() or CODEX_AGENTS_MD.is_symlink():
            CODEX_AGENTS_MD.unlink()
        CODEX_AGENTS_MD.symlink_to(SHARED_INSTRUCTIONS)
        print(f"linked  {CODEX_AGENTS_MD} -> {SHARED_INSTRUCTIONS}")
    return 1 if (check and stale) else 0


def read_skills() -> dict:
    manifest = json.loads((STACK / "stack.json").read_text())
    skills = manifest["skills"]
    if not isinstance(skills, dict):
        raise ValueError("skills must be an object")
    for skill, flags in skills.items():
        if not SKILL_NAME.fullmatch(skill):
            raise ValueError(f"invalid skill name: {skill}")
        if (not isinstance(flags, dict) or flags.keys() != SKILL_DIRS.keys()
                or any(type(flag) is not bool for flag in flags.values())):
            raise ValueError(f"{skill}: expected claude and codex boolean flags")
    return skills


def read_ledger() -> dict:
    try:
        entries = json.loads(LEDGER.read_text())
    except FileNotFoundError:
        if LEDGER.is_symlink():
            raise ValueError(f"broken ledger symlink: {LEDGER}")
        return {}
    if not isinstance(entries, list):
        raise ValueError("ledger must be an array")
    ledger = {}
    for entry in entries:
        if not isinstance(entry, dict):
            raise ValueError("invalid ledger entry")
        skill, vendor = entry.get("skill"), entry.get("vendor")
        if not isinstance(skill, str) or not SKILL_NAME.fullmatch(skill) or vendor not in SKILL_DIRS:
            raise ValueError("invalid skill or vendor in ledger")
        dest = SKILL_DIRS[vendor] / skill
        target = STACK / "skills" / skill
        if (entry.get("dest") != str(dest) or entry.get("target") != str(target)
                or not isinstance(entry.get("created_at"), str) or dest in ledger):
            raise ValueError(f"invalid ledger entry for {dest}")
        ledger[dest] = entry
    return ledger


def write_ledger(ledger: dict) -> None:
    temp = tempfile.NamedTemporaryFile(mode="w", dir=STACK, prefix=".installed.", delete=False)
    path = Path(temp.name)
    try:
        with temp:
            json.dump(list(ledger.values()), temp, indent=2)
            temp.write("\n")
            temp.flush()
            os.fsync(temp.fileno())
        path.replace(LEDGER)
    finally:
        path.unlink(missing_ok=True)


def digest_owned(skill: str) -> bool:
    return os.path.lexists(DIGESTS / skill)


def link_target(dest: Path) -> str | None:
    try:
        return os.readlink(dest)
    except FileNotFoundError:
        return None


def check_destination_parent(dest: Path) -> None:
    if dest.parent.resolve() != HOME.resolve() / dest.parent.relative_to(HOME):
        raise ValueError(f"redirected skills directory: {dest.parent}")
    if dest.parent.exists() and not dest.parent.is_dir():
        raise ValueError(f"expected skills directory: {dest.parent}")


def preflight(skill: str, destinations: list[Path], target: Path) -> dict[Path, str | None]:
    if destinations and digest_owned(skill):
        raise ValueError(f"Orca owns {skill} in {DIGESTS}")
    links = {}
    for dest in destinations:
        check_destination_parent(dest)
        try:
            link = link_target(dest)
        except OSError as error:
            if os.path.lexists(dest) and not dest.is_symlink():
                raise ValueError(f"expected a symlink at {dest}") from error
            raise
        if link is not None and Path(os.path.abspath(dest.parent / link)) != target:
            raise ValueError(f"{dest} points to {link}, expected {target}")
        links[dest] = link
    return links


def is_stack_link(dest: Path, target: Path) -> bool:
    try:
        return dest.is_symlink() and dest.resolve() == target.resolve()
    except RuntimeError:
        return False  # A symlink loop does not resolve to the stack skill.


def install(dest: Path, target: Path, skill: str, vendor: str, ledger: dict) -> None:
    if digest_owned(skill):
        raise ValueError(f"Orca owns {skill} in {DIGESTS}")
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.symlink_to(target)
    entry = {
        "dest": str(dest),
        "target": str(target),
        "vendor": vendor,
        "skill": skill,
        "created_at": datetime.now(timezone.utc).isoformat(),
    }
    try:
        write_ledger({**ledger, dest: entry})
    except OSError:
        if not digest_owned(skill) and link_target(dest) == str(target):
            dest.unlink()
        raise
    ledger[dest] = entry
    print(f"linked  {dest} -> {target}")


def remove(dest: Path, entry: dict, ledger: dict, check: bool) -> bool:
    skill, target = entry["skill"], entry["target"]
    remaining = {path: item for path, item in ledger.items() if path != dest}
    check_destination_parent(dest)
    try:
        mode = dest.lstat().st_mode
    except FileNotFoundError:
        if not check:
            write_ledger(remaining)
            del ledger[dest]
        print(f"gone    {dest}")
        return True
    if digest_owned(skill):
        raise ValueError(f"Orca owns {skill} in {DIGESTS}")
    if not stat.S_ISLNK(mode) or link_target(dest) != target:
        raise ValueError(f"{dest} no longer matches its ledger entry")
    if check:
        print(f"STALE   {dest} is disabled or removed")
        return False
    dest.unlink()
    try:
        write_ledger(remaining)
    except OSError:
        if not digest_owned(skill) and not os.path.lexists(dest):
            dest.symlink_to(target)
        raise
    del ledger[dest]
    print(f"removed {dest}")
    return True


def sync_skill(skill: str, flags: dict, ledger: dict, check: bool) -> bool:
    target = STACK / "skills" / skill
    destinations = {vendor: directory / skill for vendor, directory in SKILL_DIRS.items()}
    disabled_links = [
        dest for vendor, dest in destinations.items()
        if flags.get(vendor) is False and is_stack_link(dest, target)
    ]
    for dest in disabled_links:
        print(f"DISABLED-LINK {dest} -> {target}")
    failed = bool(disabled_links)
    enabled = [dest for vendor, dest in destinations.items() if flags.get(vendor)]
    links = preflight(skill, enabled, target)
    if enabled and not (target / "SKILL.md").is_file():
        raise ValueError(f"missing skill source: {target / 'SKILL.md'}")
    for vendor, dest in destinations.items():
        if dest not in links:
            if dest in ledger and not remove(dest, ledger[dest], ledger, check):
                failed = True
        elif links[dest] is not None:
            status = "ok" if dest in ledger else "unowned-ok"
            print(f"{status:10} {dest} -> {target}")
        elif check:
            print(f"MISSING {dest}")
            failed = True
        else:
            install(dest, target, skill, vendor, ledger)
    return failed


def sync_skills(check: bool) -> int:
    failed = False
    try:
        # Lock the existing stack directory so ledger updates cannot race another run.
        fd = os.open(STACK, os.O_RDONLY)
        try:
            fcntl.flock(fd, fcntl.LOCK_SH if check else fcntl.LOCK_EX)
            skills, ledger = read_skills(), read_ledger()
            for skill in dict.fromkeys([*skills, *(entry["skill"] for entry in ledger.values())]):
                try:
                    failed |= sync_skill(skill, skills.get(skill, {}), ledger, check)
                except (OSError, ValueError, RuntimeError) as error:
                    print(f"REFUSED {skill}: {error}", file=sys.stderr)
                    failed = True
        finally:
            os.close(fd)
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f"ERROR   stack skills: {error}", file=sys.stderr)
        return 1
    return int(failed)


def main() -> int:
    check = "--check" in sys.argv[1:]
    try:
        roles_status = sync_roles(check)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
        print(f"ERROR   role adapters: {error}", file=sys.stderr)
        roles_status = 1
    skills_status = sync_skills(check)
    return max(roles_status, skills_status)


if __name__ == "__main__":
    sys.exit(main())
